generator client {
  provider = "prisma-client-ts"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}


model usuariosPatolinopoles {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  nome    String  @unique
  senha   String
  idade   String
  role    String
}