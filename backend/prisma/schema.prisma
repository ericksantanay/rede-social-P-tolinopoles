generator client {
  provider = "prisma-client-ts"
  output   = "../src/generated"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}


model usuariosPatolinopoles {
  id              String @id @default(auto()) @map("_id") @db.ObjectId
  nome            String @unique
  senha           String
  anoNascimento   Int
  role            String
  
  postagens   postagemUser[] 
  biografias  biografiaUsuario[]
}


model postagemUser {
  id            String @id @default(auto()) @map("_id") @db.ObjectId
  postagem      String
  userId        String? @unique @db.ObjectId

  usuario  usuariosPatolinopoles? @relation(fields: [userId], references: [id])
}


model biografiaUsuario {
  id            String @id @default(auto()) @map("_id") @db.ObjectId
  biografia     String
  userId        String? @db.ObjectId @unique
  
  usuario       usuariosPatolinopoles? @relation(fields: [userId], references: [id])
}