generator client {
  provider = "prisma-client-ts"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}


model usuariosPatolinopoles {
  id              String @id @default(auto()) @map("_id") @db.ObjectId
  nome            String @unique
  senha           String
  anoNascimento   Int
  role            String
  
  postagens postagemUser[] 
}


model postagemUser {
  id            String @id @default(auto()) @map("_id") @db.ObjectId
  postagem      String
  curtidas      Int 
  userId        String? @db.ObjectId

  usuario  usuariosPatolinopoles? @relation(fields: [userId], references: [id])
}